# The API on the develop copy (branch develop): https://api.idrisi.win
# Fill in the secrets, then
# run `php artisan idrisi:check-deploy` on the server: it must say "Ready".

APP_NAME="Al-Idrisi Atelier API"
APP_ENV=staging
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.idrisi.win
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# The develop copy has its own domain (idrisi.win), separate from the
# customers' one: its sign-in cookies (session, XSRF-TOKEN) are set on its
# whole domain, and on a subdomain of the real site they would collide with
# the real site's for anyone using both. The site and its API share it.
FRONTEND_URL=https://idrisi.win
SANCTUM_STATEFUL_DOMAINS=idrisi.win
CORS_ALLOWED_ORIGINS=https://idrisi.win
SESSION_DOMAIN=.idrisi.win
# its own cookie name too, so nothing is ever mixed up with the real site
SESSION_COOKIE=idrisi_dev_session
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Cloudflare / the host's load balancer is in front of the API.
TRUSTED_PROXIES=*

# Maintenance: `php artisan down` (and `up`) from the host's console. Kept in
# the cache (the database), so it reaches every server running the API; the
# web app then shows its maintenance screen until the API is back.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

# Logs: Laravel Cloud injects its own log channel (shown under Monitoring).
LOG_LEVEL=debug

# Laravel Cloud's MySQL (Dev size, sleeps when idle): attaching the database
# to the environment injects DB_* itself, so leave these out there.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

QUEUE_CONNECTION=database
CACHE_STORE=database

# Email: a transactional sender (Resend, Postmark or Amazon SES) over SMTP,
# with the domain verified there (its SPF + DKIM records in Cloudflare).
# Resend: smtp.resend.com, port 465, user "resend", password = the API key.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
# develop: only your team signs up here
MAIL_FROM_ADDRESS="no-reply@idrisi.win"
MAIL_FROM_NAME="Al-Idrisi Atelier (develop)"

# Files (maps, uploaded stamps): Cloudflare R2, the develop bucket (never the production one).
DATA_REGION=global
REGION_GLOBAL_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=idrisi-dev
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# "Continue with Google": the develop OAuth client; add this exact
# address to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.idrisi.win/auth/google/callback

ADMIN_TWO_FACTOR_ISSUER="Al-Idrisi Atelier (develop)"
