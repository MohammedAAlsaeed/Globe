# The web app on the customers' site (branch master): https://example.sa
# example.sa stands for the production domain (to be bought): replace it.
# Set these on the Worker idrisi-app (Cloudflare → Workers & Pages →
# idrisi-app → Settings → Build → Variables and secrets). NEXT_PUBLIC_ values
# are fixed at build time: rebuild after changing them.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://example.sa
NEXT_PUBLIC_API_URL=https://api.example.sa
# Checkout page for plan upgrades (empty: the prompt says "coming soon").
NEXT_PUBLIC_UPGRADE_URL=
