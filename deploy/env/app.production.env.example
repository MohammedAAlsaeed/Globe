# The web app on the customers' site (branch master): https://idrisi.win
# Set these in the host's settings (Vercel: Project → Settings → Environment
# Variables → Production). NEXT_PUBLIC_ values are fixed at build time:
# redeploy after changing them.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://idrisi.win
NEXT_PUBLIC_API_URL=https://api.idrisi.win
# Checkout page for plan upgrades (empty: the prompt says "coming soon").
NEXT_PUBLIC_UPGRADE_URL=
