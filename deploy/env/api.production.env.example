# The API on the customers' site (branch master): https://api.example.com
# Replace example.com with your domain everywhere, fill in the secrets, then
# run `php artisan idrisi:check-deploy` on the server: it must say "Ready".

APP_NAME="Al-Idrisi Atelier API"
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# The web app. Sign-in works because the site and the API share one domain
# and the session cookie is set on it (note the leading dot).
FRONTEND_URL=https://example.com
SANCTUM_STATEFUL_DOMAINS=example.com,www.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
SESSION_DOMAIN=.example.com
SESSION_COOKIE=idrisi_session
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Cloudflare / the host's load balancer is in front of the API.
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=idrisi
DB_USERNAME=
DB_PASSWORD=

QUEUE_CONNECTION=database
CACHE_STORE=database

# Email: a transactional sender (Resend, Postmark or Amazon SES) over SMTP,
# with the domain verified there (its SPF + DKIM records in Cloudflare).
# Resend: smtp.resend.com, port 465, user "resend", password = the API key.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Al-Idrisi Atelier"

# Files (maps, uploaded stamps): Cloudflare R2, the production bucket.
DATA_REGION=global
REGION_GLOBAL_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=idrisi-prod
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# "Continue with Google": the production OAuth client; add this exact
# address to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback

ADMIN_TWO_FACTOR_ISSUER="Al-Idrisi Atelier"
