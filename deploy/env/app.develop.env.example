# The web app's develop copy (branch develop): https://idrisi.win
# Kept out of search engines (NEXT_PUBLIC_APP_ENV isn't "production").
# Set these on the Worker idrisi-app-develop (Settings → Build → Variables
# and secrets); rebuild after changing them.
NEXT_PUBLIC_APP_ENV=develop
NEXT_PUBLIC_SITE_URL=https://idrisi.win
NEXT_PUBLIC_API_URL=https://api.idrisi.win
NEXT_PUBLIC_UPGRADE_URL=
