{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components features lib tests",
    "build:webpack": "next build --webpack",
    "fonts:catalog": "node --import tsx scripts/build-font-catalog.mjs",
    "templates:earth": "node scripts/build-earth-template.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "bidi-js": "1.1.0",
    "clipper2-ts": "2.0.1",
    "fflate": "^0.8.3",
    "harfbuzzjs": "1.6.2",
    "i18next": "^26.4.2",
    "konva": "^10.6.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-konva": "^19.3.0",
    "three": "^0.186.0",
    "uqr": "0.1.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "wrangler": "^4.156.0"
  }
}
